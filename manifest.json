{
  "manifest_version": 3,
  "name": "BookmarkSaves",
  "version": "1.0",

  "description": "Baixa imagens, videos e GIFs de bookmarks salvos",

  "icons": {
    "48": "assets/icons/bookmark_48.jpg",
    "96": "assets/icons/bookmark_96.jpg"
  },

  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "cookies"
  ],

  "host_permissions": ["*://*.x.com/*"],

  "browser_specific_settings": {
    "gecko": {
      "id": "diogovf90@hotmail.com"
    }
  },

  "background": {
    "scripts": [
      "packages/browser-polyfill.min.js",
      "scripts/background/background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*/saved/*"],
      "js": [
        "packages/browser-polyfill.min.js",
        "scripts/content_scripts/tools.js",
        "scripts/content_scripts/instagram.js"
      ]
    },
    {
      "matches": ["https://x.com/i/bookmarks"],
      "js": [
        "packages/browser-polyfill.min.js",
        "scripts/content_scripts/x.js",
        "scripts/content_scripts/tools.js"
      ]
    }
  ],

  "action": {
    "default_icon": "assets/icons/bookmark_48.jpg",
    "default_title": "BookmarkSaves",
    "default_popup": "popup/index.html"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://localhost:8766"
  }
}
